# ============================================================
# FUJISAN 環境変数テンプレート
# ------------------------------------------------------------
# ローカル開発:
#   cp .env.example .dev.vars
# ※ `.env.local` ではなく **`.dev.vars`** が真の env ファイルです。
#    initOpenNextCloudflareForDev() が dev でもここから env と
#    D1 バインディングを供給します。`.dev.vars` は .gitignore 済み。
#
# 本番（Cloudflare Workers）:
#   npx wrangler secret put <NAME>
#
# D1 の接続情報は wrangler.jsonc の d1_databases に書かれており、
# ここに DATABASE_URL のような接続文字列は不要です。
# ============================================================

# --- Better Auth（必須） ---
# 32バイトのシークレット: openssl rand -base64 32
BETTER_AUTH_SECRET=
# サイトの公開 URL。Stripe の success_url / cancel_url の基底にもなるため、
# 環境ごとに正しく設定しないと決済後に戻れません。
BETTER_AUTH_URL=http://localhost:3000

# --- 管理者（必須） ---
# owner 権限を持つメールアドレスをカンマ区切りで指定します。
# 未設定だと誰も管理画面に入れません（/admin/orders・/admin/team）。
ADMIN_EMAILS=

# --- Stripe（決済に必須） ---
# 未設定だとカートの「お支払いへ進む」が config エラーを返します。
STRIPE_SECRET_KEY=
# ローカルは `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# が表示する whsec_... を設定します。本番は Stripe ダッシュボードの値。
STRIPE_WEBHOOK_SECRET=

# --- メール送信（Resend / 任意） ---
# 未設定ならメールは送らずコンソールに出力されます（ローカルで
# メール認証リンクをそのまま踏めます）。本番では必須。
RESEND_API_KEY=
RESEND_FROM=FUJISAN SAKE <onboarding@resend.dev>

# --- Google ログイン（任意） ---
# 両方設定するとログイン画面に Google ボタンが表示されます。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- 運用アラート（任意） ---
# Webhook で注文確定に失敗した等の障害を通知する汎用 Webhook。
# Slack / Discord の Incoming Webhook URL を想定（JSON `{ text }` を POST）。
# 未設定でも ADMIN_EMAILS 宛のメール通知は動きます。
OPS_WEBHOOK_URL=
