# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude local settings
.claude/settings.local.json

# cloudflare
.open-next
.wrangler
cloudflare-env.d.ts

# wrangler local secrets
.dev.vars

# agent skills (npx skills add で再生成可能。共有したい場合はこの行を消す)
.agents/
skills/
skills-lock.json
.claude/skills/
.gstack/

# iCloud / ファイル同期が作る複製（"gsap-setup 2.ts" のような名前）。
# 中身は元ファイルと同一で、import されることもないが、git add -A で
# 紛れ込むと本物と紛らわしい。実際に一度コミットされた。
*\ [0-9].ts
*\ [0-9].tsx
*\ [0-9].json
*\ [0-9].css
