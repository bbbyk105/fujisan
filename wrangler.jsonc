{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "fujisan",
	"compatibility_date": "2026-04-30",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	// 本番ドメイン。www と workers.dev は next.config.ts で apex へ 308 で寄せる。
	// workers.dev を残すのは、旧 URL のままの Stripe Webhook（sandbox など）が残っていても
	// 受けられるようにするため。どこも workers.dev を向いていないと確かめたら false にしてよい。
	"routes": [
		{ "pattern": "sakefujisan.com", "custom_domain": true },
		{ "pattern": "www.sakefujisan.com", "custom_domain": true }
	],
	"workers_dev": true,
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "fujisan-db",
			"database_id": "bbf2da87-f1d3-4eeb-ad4e-308b7ea3522b",
			"migrations_dir": "drizzle"
		}
	]
}
